// datasource db defines the database connection details.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// generator client specifies the Prisma Client generator.
generator client {
  provider = "prisma-client-js"
}

// User model represents users of the application.
model User {
  id                     String    @id @default(cuid())
  firstName              String
  lastName               String
  phoneNumber            String    @unique
  email                  String?   @unique
  password               String?
  passwordUpdatedAt      DateTime? @default(now())
  failedLoginAttempts    Int       @default(0)
  lockoutUntil           DateTime? 
  roleId                 String
  branchId               String?
  nibBankAccount         String?
  status                 UserStatus @default(ACTIVE)
  passwordChangeRequired Boolean   @default(false)
  tokenVersion           Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  organizerId            String?

  role     Role     @relation(fields: [roleId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  events   Event[]  @relation("EventOrganizer")
  attendees Attendee[]
  organizedStaff User[] @relation("OrganizerStaff")
  organizer      User?  @relation("OrganizerStaff", fields: [organizerId], references: [id])
  sessions Session[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  revokedAt        DateTime?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, createdAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
}

// Role model represents user roles with specific permissions.
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  permissions String? // Storing permissions as a JSON string for flexibility (will be migrated to relational table)
  // New relation to store permissions in relational form
  rolePermissions RolePermission[]
  users       User[]
}

// Permission model represents a single permission identifier, e.g. "Events:Create"
model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

// Join table between Role and Permission
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model District {
  id                 String   @id @default(cuid())
  name               String   @unique
  contactPersonName  String
  contactPersonPhone String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branches           Branch[]
}

model Branch {
  id                 String    @id @default(cuid())
  name               String
  contactPersonName  String
  contactPersonPhone String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  districtId         String
  district           District  @relation(fields: [districtId], references: [id])
  users              User[]
}

// Event model represents events created by organizers.
model Event {
  id              Int          @id @default(autoincrement())
  name            String
  description     String
  startDate       DateTime
  endDate         DateTime?
  location        String
  hint            String?
  image           String?
  category        String
  organizerId     String
  status          EventStatus  @default(PENDING)
  rejectionReason String?
  nibBankAccount  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organizer   User          @relation("EventOrganizer", fields: [organizerId], references: [id])
  ticketTypes TicketType[]
  attendees   Attendee[]
  promoCodes  PromoCode[]
  payments    EventPayment[]
  pendingOrders PendingOrder[]
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

// TicketType model represents different types of tickets for an event.
model TicketType {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  basePrice     Decimal  @db.Decimal(10, 2)
  total         Int
  sold          Int      @default(0)
  eventId       Int
  locationPrices Json?

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendees Attendee[]
}

// Attendee model represents an individual who purchased a ticket.
model Attendee {
  id           Int      @id @default(autoincrement())
  name         String
  phoneNumber  String?
  userId       String?
  eventId      Int
  ticketTypeId Int
  checkedIn    Boolean  @default(false)
  qrCode       String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User?          @relation(fields: [userId], references: [id])
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  pendingOrder PendingOrder[]
}

// PromoCode model represents promotional codes for events.
model PromoCode {
  id      Int           @id @default(autoincrement())
  code    String
  type    PromoCodeType
  value   Decimal       @db.Decimal(10, 2)
  uses    Int           @default(0)
  maxUses Int
  eventId Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

// PendingOrder model for tracking payments before they are confirmed.
model PendingOrder {
  id               Int      @id @default(autoincrement())
  transactionId    String   @unique
  arifpaySessionId String?  @unique
  eventId          Int
  ticketTypeId     Int
  attendeeData     Json
  promoCode        String?
  status           String   @default("PENDING") // PENDING, COMPLETED, FAILED
  attendeeId       Int?     @unique
  createdAt        DateTime @default(now())

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee Attendee? @relation(fields: [attendeeId], references: [id])
  payments EventPayment[]
}

model EventPayment {
  id             String    @id @default(cuid())
  eventId        Int
  pendingOrderId Int
  amount         Decimal   @db.Decimal(10, 2)
  method         String // e.g., 'GATEWAY', 'MANUAL'
  status         String // e.g., 'PENDING', 'COMPLETED', 'FAILED'
  transactionId  String    @unique
  reference      String? // Gateway's own transaction reference
  sessionId      String? // Payment gateway session ID
  paymentDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pendingOrder PendingOrder @relation(fields: [pendingOrderId], references: [id], onDelete: Cascade)
}

// Track failed login attempts per IP address to enforce IP-based lockouts.
model FailedIpAttempt {
  id           String   @id @default(cuid())
  ip           String   @unique
  attempts     Int      @default(0)
  lockoutUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Homepage hero carousel ads (admin-managed only; separate from event images).
model HomeCarouselAd {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String?
  caption   String?
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
