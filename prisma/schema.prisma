// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              Int      @id @default(autoincrement())
  name            String
  description     String
  startDate       DateTime
  endDate         DateTime?
  location        String
  category        String
  image           String?
  hint            String?
  status          EventStatus @default(PENDING)
  rejectionReason String?
  organizerId     String
  nibBankAccount  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizer   User          @relation(fields: [organizerId], references: [id])
  ticketTypes TicketType[]
  attendees   Attendee[]
  promoCodes  PromoCode[]
  payments    EventPayment[]
  pendingOrders PendingOrder[]
}

model TicketType {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  basePrice      Decimal         @db.Decimal(10, 2)
  total          Int
  sold           Int             @default(0)
  locationPrices Json?
  eventId        Int
  
  event          Event           @relation(fields: [eventId], references: [id])
  attendees      Attendee[]
  pendingOrders  PendingOrder[]
}

model Attendee {
  id           Int      @id @default(autoincrement())
  name         String
  phoneNumber  String?
  checkedIn    Boolean  @default(false)
  qrCode       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  eventId      Int
  ticketTypeId Int
  userId       String?

  event       Event      @relation(fields: [eventId], references: [id])
  ticketType  TicketType @relation(fields: [ticketTypeId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])
  pendingOrders PendingOrder[]
}

model User {
  id                       String      @id
  firstName                String
  lastName                 String
  phoneNumber              String      @unique
  email                    String?     @unique
  nibBankAccount           String?
  passwordChangeRequired   Boolean     @default(true)
  status                   UserStatus  @default(INACTIVE)
  tempPass                 String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  roleId                   String
  branchId                 String?
  organizerId              String?
  
  role                     Role        @relation(fields: [roleId], references: [id])
  branch                   Branch?     @relation(fields: [branchId], references: [id])
  events                   Event[]
  attendees                Attendee[]
  organizer                User?       @relation("UserToStaff", fields: [organizerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff                    User[]      @relation("UserToStaff")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String?

  users User[]
}

model PromoCode {
  id      Int         @id @default(autoincrement())
  code    String      @unique
  type    PromoCodeType
  value   Decimal     @db.Decimal(10, 2)
  maxUses Int
  uses    Int         @default(0)
  eventId Int
  event   Event       @relation(fields: [eventId], references: [id])
}

model PendingOrder {
  id               Int      @id @default(autoincrement())
  transactionId    String   @unique
  arifpaySessionId String?  @unique
  status           OrderStatus @default(PENDING)
  attendeeData     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  eventId          Int
  ticketTypeId     Int
  promoCode        String?
  attendeeId       Int?     @unique

  event        Event         @relation(fields: [eventId], references: [id])
  ticketType   TicketType    @relation(fields: [ticketTypeId], references: [id])
  attendee     Attendee?     @relation(fields: [attendeeId], references: [id])
  payments     EventPayment[]
}

model EventPayment {
  id             String    @id @default(uuid())
  amount         Decimal   @db.Decimal(10, 2)
  method         String
  status         String
  sessionId      String?
  transactionId  String    @unique
  paymentDate    DateTime?
  reference      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  pendingOrderId Int
  eventId        Int

  pendingOrder PendingOrder @relation(fields: [pendingOrderId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
}

model District {
  id                  String   @id @default(uuid())
  name                String   @unique
  contactPersonName   String
  contactPersonPhone  String
  
  branches Branch[]
}

model Branch {
  id                  String   @id @default(uuid())
  name                String
  contactPersonName   String
  contactPersonPhone  String
  districtId          String

  district District @relation(fields: [districtId], references: [id])
  users    User[]
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}
