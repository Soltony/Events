
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                     String    @id
  firstName              String
  lastName               String
  phoneNumber            String    @unique
  email                  String?   @unique
  passwordChangeRequired Boolean   @default(true)
  status                 UserStatus @default(INACTIVE)
  nibBankAccount         String?
  roleId                 String
  branchId               String?
  tempPass               String?

  role    Role     @relation(fields: [roleId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id])
  events  Event[]
  tickets Attendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        UserRole @unique
  description String?
  permissions String?
  users       User[]
}

model District {
  id                String   @id @default(cuid())
  name              String   @unique
  contactPersonName String
  contactPersonPhone String
  branches          Branch[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Branch {
  id                 String    @id @default(cuid())
  name               String
  districtId         String
  contactPersonName  String
  contactPersonPhone String
  users              User[]
  district           District  @relation(fields: [districtId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Event {
  id             Int       @id @default(autoincrement())
  name           String
  description    String    @db.Text
  startDate      DateTime
  endDate        DateTime?
  location       String
  hint           String?
  category       String
  image          String?
  color          String?
  status         EventStatus @default(PENDING)
  rejectionReason String?
  organizerId    String
  nibBankAccount String?

  organizer   User          @relation(fields: [organizerId], references: [id])
  ticketTypes TicketType[]
  attendees   Attendee[]
  promoCodes  PromoCode[]
  payments    EventPayment[]
  pendingOrders PendingOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketType {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  total       Int
  sold        Int      @default(0)
  eventId     Int
  locationPrices Json?

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendees Attendee[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendee {
  id           Int      @id @default(autoincrement())
  name         String
  phoneNumber  String?
  userId       String?
  eventId      Int
  ticketTypeId Int
  checkedIn    Boolean  @default(false)
  qrCode       String   @unique

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  pendingOrders PendingOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id      Int         @id @default(autoincrement())
  code    String      
  type    PromoCodeType
  value   Decimal     @db.Decimal(10, 2)
  maxUses Int
  uses    Int         @default(0)
  eventId Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([code, eventId])
}

model PendingOrder {
  id          Int      @id @default(autoincrement())
  arifpaySessionId String? @unique
  transactionId String @unique
  eventId     Int
  ticketTypeId Int? // Storing primary ticket type for simplicity
  attendeeId  Int?     @unique
  attendeeData Json
  promoCode   String?
  status      OrderStatus @default(PENDING)

  event    Event    @relation(fields: [eventId], references: [id])
  attendee Attendee? @relation(fields: [attendeeId], references: [id])
  payments EventPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventPayment {
  id             Int      @id @default(autoincrement())
  pendingOrderId Int      @unique
  eventId        Int
  amount         Decimal  @db.Decimal(10, 2)
  method         String
  status         PaymentStatus
  paymentDate    DateTime?
  reference      String?
  sessionId      String? // arifpay session id, nib payment token
  transactionId  String?  @unique // gateway transaction id

  pendingOrder PendingOrder @relation("EventPaymentToPendingOrder", fields: [pendingOrderId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  Admin
  Organizer
  Staff
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
