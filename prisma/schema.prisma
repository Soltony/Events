// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id               Int            @id @default(autoincrement())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime?
  location         String
  hint             String?
  category         String
  image            String?
  status           EventStatus    @default(PENDING)
  rejectionReason  String?
  organizer        User           @relation(fields: [organizerId], references: [id])
  organizerId      String
  ticketTypes      TicketType[]
  attendees        Attendee[]
  promoCodes       PromoCode[]
  pendingOrders    PendingOrder[]
  payments         EventPayment[]
  nibBankAccount   String?
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

model TicketType {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  basePrice      Decimal         @db.Decimal(10, 2)
  total          Int
  sold           Int
  event          Event           @relation(fields: [eventId], references: [id])
  eventId        Int
  attendees      Attendee[]
  locationPrices Json?
}

model Attendee {
  id           Int           @id @default(autoincrement())
  name         String
  phoneNumber  String?
  email        String?
  eventId      Int
  event        Event         @relation(fields: [eventId], references: [id])
  ticketTypeId Int
  ticketType   TicketType    @relation(fields: [ticketTypeId], references: [id])
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  checkedIn    Boolean       @default(false)
  qrCode       String        @unique
  createdAt    DateTime      @default(now())
  pendingOrder PendingOrder?
}

model User {
  id                     String    @id @unique
  firstName              String
  lastName               String
  phoneNumber            String    @unique
  email                  String?   @unique
  roleId                 String
  role                   Role      @relation(fields: [roleId], references: [id])
  events                 Event[]
  attendees              Attendee[]
  passwordChangeRequired Boolean   @default(true)
  status                 UserStatus @default(INACTIVE)
  tempPass               String?
  nibBankAccount         String?
  branchId               String?
  branch                 Branch?   @relation(fields: [branchId], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  permissions String?
  users       User[]
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model PromoCode {
  id      Int           @id @default(autoincrement())
  code    String        @unique
  type    PromoCodeType
  value   Decimal       @db.Decimal(10, 2)
  maxUses Int
  uses    Int           @default(0)
  event   Event         @relation(fields: [eventId], references: [id])
  eventId Int
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

model PendingOrder {
  id               String         @id @default(cuid())
  transactionId    String         @unique
  arifpaySessionId String?
  eventId          Int
  event            Event          @relation(fields: [eventId], references: [id])
  ticketTypeId     Int?
  attendeeData     Json
  promoCode        String?
  status           String         @default("PENDING")
  attendeeId       Int?           @unique
  attendee         Attendee?      @relation(fields: [attendeeId], references: [id])
  payments         EventPayment[] @relation("EventPaymentToPendingOrder")
  createdAt        DateTime       @default(now())
}

model EventPayment {
  id             String       @id @default(cuid())
  amount         Float
  method         String
  status         String
  sessionId      String?
  transactionId  String       @unique
  paymentDate    DateTime?
  reference      String?
  pendingOrderId String
  pendingOrder   PendingOrder @relation("EventPaymentToPendingOrder", fields: [pendingOrderId], references: [id])
  eventId        Int
  event          Event        @relation(fields: [eventId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model District {
  id                 String   @id @default(cuid())
  name               String   @unique
  contactPersonName  String
  contactPersonPhone String
  branches           Branch[]
}

model Branch {
  id                 String   @id @default(cuid())
  name               String
  districtId         String
  district           District @relation(fields: [districtId], references: [id])
  contactPersonName  String
  contactPersonPhone String
  users              User[]
}
