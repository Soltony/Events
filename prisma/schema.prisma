
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String     @id @default(cuid())
  firstName               String
  lastName                String
  phoneNumber             String     @unique
  email                   String?    @unique
  password                String
  roleId                  String
  role                    Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId                String?
  branch                  Branch?    @relation(fields: [branchId], references: [id])
  nibBankAccount          String?
  status                  UserStatus @default(ACTIVE)
  passwordChangeRequired  Boolean    @default(true)
  tokenVersion            Int        @default(1)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  organizedEvents         Event[]    @relation("OrganizerEvents")
  createdStaff            User[]     @relation("OrganizerToStaff")
  organizer               User?      @relation("OrganizerToStaff", fields: [organizerId], references: [id])
  organizerId             String?
  attendees               Attendee[]

  @@index([roleId])
  @@index([branchId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  permissions String
  users       User[]
}

model Event {
  id              Int           @id @default(autoincrement())
  name            String
  description     String
  image           String?
  location        String
  hint            String?
  startDate       DateTime
  endDate         DateTime?
  category        String
  status          EventStatus   @default(PENDING)
  rejectionReason String?
  organizerId     String
  organizer       User          @relation("OrganizerEvents", fields: [organizerId], references: [id])
  nibBankAccount  String?
  ticketTypes     TicketType[]
  attendees       Attendee[]
  promoCodes      PromoCode[]
  payments        EventPayment[]
  pendingOrders   PendingOrder[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizerId])
}

model TicketType {
  id             Int        @id @default(autoincrement())
  name           String
  description    String?
  basePrice      Decimal    @db.Decimal(10, 2)
  total          Int
  sold           Int        @default(0)
  eventId        Int
  event          Event      @relation(fields: [eventId], references: [id])
  attendees      Attendee[]
  locationPrices Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([eventId])
}

model Attendee {
  id           Int         @id @default(autoincrement())
  name         String
  phoneNumber  String?
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  eventId      Int
  event        Event       @relation(fields: [eventId], references: [id])
  ticketTypeId Int
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id])
  checkedIn    Boolean     @default(false)
  qrCode       String      @unique @default(cuid())
  pendingOrder PendingOrder[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([ticketTypeId])
}

model PromoCode {
  id        Int         @id @default(autoincrement())
  code      String      @unique
  type      PromoCodeType
  value     Decimal     @db.Decimal(10, 2)
  maxUses   Int
  uses      Int         @default(0)
  eventId   Int
  event     Event       @relation(fields: [eventId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([eventId])
}

model District {
  id                  String   @id @default(cuid())
  name                String   @unique
  contactPersonName   String
  contactPersonPhone  String
  branches            Branch[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Branch {
  id                  String   @id @default(cuid())
  name                String
  districtId          String
  district            District @relation(fields: [districtId], references: [id])
  contactPersonName   String
  contactPersonPhone  String
  users               User[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([districtId])
}

// Models for Payment Integration
model EventPayment {
  id             Int          @id @default(autoincrement())
  amount         Float
  method         String // E.g., 'ARIFPAY', 'CHAPA', 'NIB'
  status         String // E.g., 'PENDING', 'COMPLETED', 'FAILED'
  transactionId  String       @unique // Our internal ID for this payment attempt
  reference      String? // ID from the payment gateway (e.g., checkout_session_id)
  sessionId      String? // Session ID from gateway (if applicable)
  paymentDate    DateTime?
  eventId        Int
  event          Event        @relation(fields: [eventId], references: [id])
  pendingOrderId Int
  pendingOrder   PendingOrder @relation(fields: [pendingOrderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([eventId])
  @@index([pendingOrderId])
}

model PendingOrder {
  id              Int           @id @default(autoincrement())
  transactionId   String        @unique
  eventId         Int
  event           Event         @relation(fields: [eventId], references: [id])
  ticketTypeId    Int
  attendeeData    Json
  promoCode       String?
  status          String        @default("PENDING") // PENDING, COMPLETED, FAILED
  arifpaySessionId String?      @unique
  attendeeId      Int?          @unique
  attendee        Attendee?     @relation(fields: [attendeeId], references: [id])
  payment         EventPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([eventId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
